<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="SeamlessCoopManager.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:SeamlessCoopManager"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="Seamless Co-op Manager">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Padding="28,24,28,16" Spacing="2">
            <TextBlock
                Text="Seamless Co-op Manager"
                Style="{StaticResource TitleTextBlockStyle}" />
            <TextBlock
                Text="Drop your mod update and apply it to your game"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Style="{StaticResource CaptionTextBlockStyle}" />
        </StackPanel>

        <!-- Drop Zone -->
        <Grid
            Grid.Row="1"
            Margin="24,0,24,0"
            x:Name="DropZoneGrid"
            AllowDrop="True"
            DragOver="DropZone_DragOver"
            DragLeave="DropZone_DragLeave"
            Drop="DropZone_Drop"
            Tapped="DropZone_Tapped">

            <!-- Dashed border background -->
            <Rectangle
                x:Name="DropZoneBorder"
                StrokeDashArray="4 3"
                StrokeThickness="1.5"
                RadiusX="12" RadiusY="12"
                Stroke="{ThemeResource DividerStrokeColorDefaultBrush}"
                Fill="{ThemeResource LayerFillColorDefaultBrush}" />

            <!-- Content — hit-test transparent so taps/drags register on the Grid -->
            <StackPanel
                VerticalAlignment="Center"
                HorizontalAlignment="Center"
                Spacing="12"
                IsHitTestVisible="False">

                <FontIcon
                    x:Name="DropZoneIcon"
                    Glyph="&#xE8B7;"
                    FontSize="48"
                    Foreground="{ThemeResource AccentFillColorDefaultBrush}"
                    HorizontalAlignment="Center" />

                <StackPanel HorizontalAlignment="Center" Spacing="4">
                    <TextBlock
                        x:Name="DropZoneTitle"
                        Text="Drop your mod .zip here"
                        Style="{StaticResource SubtitleTextBlockStyle}"
                        TextAlignment="Center" />
                    <TextBlock
                        x:Name="DropZoneSubtitle"
                        Text="or click to browse"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        TextAlignment="Center"
                        HorizontalAlignment="Center" />
                </StackPanel>
            </StackPanel>
        </Grid>

        <!-- Bottom Controls -->
        <StackPanel Grid.Row="2" Padding="24,16,24,28" Spacing="12">

            <!-- Game picker -->
            <ComboBox
                x:Name="GameComboBox"
                Header="Game"
                PlaceholderText="Select a game..."
                HorizontalAlignment="Stretch"
                SelectionChanged="GameComboBox_SelectionChanged" />

            <!-- Install directory -->
            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBox
                    x:Name="InstallPathBox"
                    Grid.Column="0"
                    Header="Install Directory"
                    PlaceholderText="No directory set"
                    IsReadOnly="True" />

                <Button
                    x:Name="BrowseDirectoryButton"
                    Grid.Column="1"
                    VerticalAlignment="Bottom"
                    Content="Browse"
                    IsEnabled="False"
                    Click="BrowseDirectory_Click" />
            </Grid>

            <!-- Game executable -->
            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBox
                    x:Name="ExecPathBox"
                    Grid.Column="0"
                    Header="Game Executable"
                    PlaceholderText="No executable set"
                    IsReadOnly="True" />

                <Button
                    x:Name="BrowseExecutableButton"
                    Grid.Column="1"
                    VerticalAlignment="Bottom"
                    Content="Browse"
                    IsEnabled="False"
                    Click="BrowseExecutable_Click" />
            </Grid>

            <!-- Retain settings -->
            <CheckBox
                x:Name="RetainSettingsCheckBox"
                Content="Retain user settings after update"
                IsChecked="True"
                IsEnabled="False"
                Checked="RetainSettings_Checked"
                Unchecked="RetainSettings_Unchecked" />

            <!-- Actions -->
            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="2*" />
                </Grid.ColumnDefinitions>

                <Button
                    x:Name="LaunchButton"
                    Grid.Column="0"
                    HorizontalAlignment="Stretch"
                    Height="48"
                    IsEnabled="False"
                    Click="LaunchGame_Click">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE768;" FontSize="14" />
                        <TextBlock Text="Launch Game" />
                    </StackPanel>
                </Button>

                <Button
                    x:Name="ApplyButton"
                    Grid.Column="1"
                    Content="Apply Update"
                    Style="{StaticResource AccentButtonStyle}"
                    HorizontalAlignment="Stretch"
                    Height="48"
                    IsEnabled="False"
                    Click="ApplyButton_Click" />
            </Grid>

        </StackPanel>
    </Grid>
</Window>
